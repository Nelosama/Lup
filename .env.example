# Copy to backend/.env for the API and Prisma. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lup:lup_local_only@localhost:5432/lup?schema=public
DIRECT_URL=postgresql://lup:lup_local_only@localhost:5432/lup?schema=public
WEB_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
MAIL_MODE=local
LOCAL_OUTBOX_DIR=.local/outbox
PORTFOLIO_LIMIT=12
SUPABASE_STORAGE_BUCKET=lup-images
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-frontend
# Frontend: copy frontend/.env.example to frontend/.env
# Production email: only configure a provider you have authorized. No provider is provisioned.
# MAIL_MODE=smtp
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-secret
# MAIL_FROM=hello@your-domain.example
# MAIL_ENCRYPTION_KEY=64-hex-characters-generated-with-openssl-rand-hex-32
# HTTP mail adapter for hosts whose free plan blocks SMTP ports:
# MAIL_MODE=resend
# RESEND_API_KEY=server-only-key-from-your-authorized-account
